import random
print("Welcome to password generator")
lower_alphabets= [chr(i) for i in range (ord('a'), ord('z')+1)]
upper_alphabets= [chr(i) for i in range (ord('A'), ord('Z')+1)]
numbers= [chr(i) for i in range (ord("0"),ord('9') + 1)]
symbols = [
    '!', '@', '#', '$', '%', '^', '&', '*',
    '(', ')', '-', '_', '=', '+',
    '[', ']', '{', '}',
    ';', ':', ',', '.',
    '<', '>', '?', '/',
    '|', '~', '`'
]

def get_password_length():
      while True:
            try:
                  password_len= input("Enter password length (8–24):\nPress Enter to use the default (8).\n").strip()
                  if password_len == "":
                        return 8
                  else:
                        password_len = int(password_len)
                        if 8<= password_len <=24:
                            return password_len
                        else:
                              print("Try putting something between 8 and 24! ")
            except ValueError:
                  print("Type a number like 5, 6 or 8")

def get_capital_letters():
      while True:
            upper_case= input("Do you want capital letters (Yes/y or No/n) : \n").strip().lower()
            if upper_case in ("yes", "y"):
                  return upper_alphabets
            elif upper_case in ('no',"n"):
                  return []
            else:
                  print("Enter a valid input! ")

def get_numbers():
      while True:
            num= input("Do you want Numbers (Yes/y or No/n) : \n").strip().lower()
            if num in ("yes", "y"):
                  return numbers
            elif num in ('no',"n"):
                  return []
            else:
                  print("Enter a valid input! ")

def get_symbols():
      while True:
            sym= input("Do you want Symbols (Yes/y or No/n) : \n").strip().lower()
            if sym in ("yes", "y"):
                  return symbols
            elif sym in ('no',"n"):
                  return []
            else:
                  print("Enter a valid input! ")

def generate_pass():
      password_length = get_password_length()
      capiletter= get_capital_letters()
      num_char=get_numbers()
      symbo= get_symbols()
      final_list_= lower_alphabets+ capiletter + num_char+ symbo
      _finalpasscharacters= []
      for _ in range (0,password_length):
            _finalpasscharacters += random.choice(final_list_)

      final_password = "".join(_finalpasscharacters)
      print("Your final password generated is:")
      print(final_password)

generate_pass()

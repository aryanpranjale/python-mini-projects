def random_word_picker():
      # picks a random word from a csv file
      file_path = Path(__file__).parent / "words.csv"

      with open(file_path,"r") as file:
            filepath= csv.DictReader(file)
            wordlist= []
            dif_level=["easy","medium","hard"]
            valid_userselection = [1,2,3]
            print('''1. Easy
2. Medium
3. Hard''')
            while True:
                  # asks the user for the difficulty level and returns a list of words
                  try:
                        
                        mode= int(input("Select the Difficulty: \n"))
                        if mode in valid_userselection:
                              selectmode = dif_level[mode - 1]
                              for row in filepath:
                                    if row["difficulty"] == selectmode:
                                          wordlist.append(row["word"])
                              break
                        else:
                              print('''Please choose:
1 - Easy
2 - Medium
3 - Hard''')
                  except ValueError:
                        print("Enter a 1,2 or 3 for difficulty level you want to play")
      # after picking up the list, function returns only one word to the code           
      word = random.choice(wordlist)
      return word

def create_hidden_word(word):
      # converts the random word into hidden word
      hidden_word = []
      for _ in range (len(word)):
            hidden_word.append("_")
      return hidden_word
def userguess_verifier():
      # validates the user guess
      while True:
            userinp= input("Guess the alphabet: \n").strip().lower()
            if userinp.isalpha() and len(userinp) == 1 :
                  return userinp
            else:
                  print("Try guessing a letter!")
                             

def play_game(word,hid_list):
      lives= 6
      print (hangman_stages[0])

      guessed_letters=[]
      while "_" in hid_list and lives > 0:
            user_guess= userguess_verifier()

            if user_guess not in guessed_letters:
                  if user_guess in word:
                        for i in range (len(hid_list)):
                              if word[i] == user_guess:
                                    hid_list[i] = user_guess
                  else:
                        lives -= 1
                        
                  guessed_letters.append(user_guess)
            else:
                  print("You have guessed this letter before try again with other letter!")
            print(hangman_stages[6-lives])
            print(f"Lives remaining: {lives}")
            print(" ". join(hid_list))
            print("Guessed letters:\n" , ",".join(guessed_letters) )
      if "_" not in hid_list:
            print("Congratulations! you have successfully Guessed the word")
      elif lives == 0:
            print("Good try! You lost all your lives.")
            print(f"The word was: {word}")
            


            
